        <mxCell id="rules" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#ffffff;fontSize=24;" value="READING THE DIAGRAM&lt;br&gt;Underlined ovals = keys. Double lines = total participation.&lt;br&gt;(min,max) gives occurrences of a relationship for one entity instance.&lt;br&gt;Address and dropoff_address are composite; their leaf attributes become columns.&lt;br&gt;Dashed amount_due is calculated, not stored. Phone is single-valued.&lt;br&gt;CONTAINS maps to ORDER_ITEM with PK(order_id,item_id).&lt;br&gt;DELIVERY uses its linked Order as its identity: at most one delivery per order.&lt;br&gt;Crossing connectors without a junction do not form a relationship." vertex="1">
          <mxGeometry height="380" width="1130" x="2420" y="2470" as="geometry" />
        </mxCell>
        <mxCell id="formula" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#ffffff;fontSize=26;" value="amount_due = SUM(quantity * agreed_unit_price) + delivery_fee&lt;br&gt;The agreed price and delivery destination are captured when ordering." vertex="1">
          <mxGeometry height="100" width="2200" x="1150" y="2760" as="geometry" />
        </mxCell>
        <mxCell id="source" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#ffffff;fontSize=24;" value="Lecture-style EER based on M2_1, M2_2 and M2_3. Mapping steps: EER_TO_RELATIONS_STEP_BY_STEP.md." vertex="1">
          <mxGeometry height="50" width="3440" x="60" y="2920" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
